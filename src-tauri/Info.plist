        <key>default</key>
        <string>Add to Pluck</string>
      </dict>
      <key>NSMessage</key>
      <string>addToPluck</string>
      <key>NSPortName</key>
      <string>Pluck</string>
      <key>NSSendTypes</key>
      <array>
        <string>public.utf8-plain-text</string>
        <string>NSStringPboardType</string>
      </array>
      <key>NSRequiredContext</key>
