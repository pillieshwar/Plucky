{
  // The TodoCity sync relay: stores and forwards encrypted boxes between
  // a person's Macs. Deployed by .github/workflows/relay.yml.
  "name": "todocity-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  // Each mailbox and pairing room gets its own SQLite database.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Room"] }
  ],
  // Per network address, per minute.
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "4101", "simple": { "limit": 1200, "period": 60 } },
    { "name": "PAIR_IP", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ],
  // No request logs: the relay keeps nothing it doesn't need.
  "observability": { "enabled": false }
}
