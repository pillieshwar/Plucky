{
  // The Todo City sync relay: stores and forwards encrypted boxes between
  // a person's Macs. Deployed by .github/workflows/relay.yml.
  "name": "todocity-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  // Each mailbox gets its own SQLite database.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }],
  // No request logs: the relay keeps nothing it doesn't need.
  "observability": { "enabled": false }
}
